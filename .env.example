# Database
DATABASE_URL=postgresql://builtattic:builtattic_dev@localhost:5432/builtattic_brain

# AI provider
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5

# Google Gemini (use current model ids, e.g. gemini-2.5-flash or gemini-2.5-pro; gemini-1.5-* is retired on the API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro
# Scoring weights config (optional override)
WEIGHTS_FILE=scoring_weights.json
